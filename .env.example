# Web3Forms access key for the contact form (components/ContactForm.tsx).
# Sign up free at https://web3forms.com to get one, then set this in
# Vercel: Project Settings → Environment Variables (and in a local
# .env.local for development). Safe to expose to the client — that's how
# Web3Forms is designed to work.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
